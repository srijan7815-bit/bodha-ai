rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // uploads/{...} — legacy flat path, kept for safety
    match /uploads/{allPaths=**} {
      allow read, write: if false;
    }

    // ── users/{uid}/uploads/{docId} — raw uploaded files ───────────────────
    match /users/{uid}/uploads/{docId} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.size < 21 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|text/.*');
      allow delete: if isOwner(uid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
