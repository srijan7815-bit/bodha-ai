rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── users/{uid} — profiles ─────────────────────────────────────────────
    match /users/{uid} {
      allow get, create, update: if isOwner(uid);
      allow delete: if false; // profiles are managed server-side

      // ── users/{uid}/chats/{chatId} — conversations ───────────────────────
      match /chats/{chatId} {
        allow read, create, update, delete: if isOwner(uid)
          && (request.method != 'create' || request.resource.data.userId == uid);

        // ── users/{uid}/chats/{chatId}/messages/{messageId} ─────────────────
        match /messages/{messageId} {
          allow read, create, update, delete: if isOwner(uid);
        }
      }

      // ── users/{uid}/documents/{docId} — library metadata ──────────────────
      match /documents/{docId} {
        allow read, create, update, delete: if isOwner(uid);
      }
    }

    // Anything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
