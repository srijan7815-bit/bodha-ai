# BODHA — environment variables.
# Copy to .env for local work (it is git-ignored). On Vercel, add the same names under
# Project → Settings → Environment Variables. Never commit real values.
# Full guide: docs/ENVIRONMENT.md   ·   Integrations: docs/INTEGRATIONS.md
# Check yours: npm run check:env        Check the new services: node scripts/check-integrations.mjs

# ─── Required ─────────────────────────────────────────────────────────────────
# Answers, OCR (NVIDIA NIM). Get it at build.nvidia.com → your profile → API keys.
NVIDIA_API_KEY=

# Where chats, accounts and uploaded books are stored (Firestore).
FIREBASE_ADMIN_PROJECT_ID=

# Firebase service account e-mail (…@….iam.gserviceaccount.com).
FIREBASE_ADMIN_CLIENT_EMAIL=

# Firebase service account private key. Firebase console → Project settings → Service accounts → Generate new private key. Paste the whole key, with real line breaks or with \n.
FIREBASE_ADMIN_PRIVATE_KEY=

# BODHA's voice: read-aloud and Live Mode (Fish Audio).
FISH_AUDIO_API_KEY=

# Dictation and Live Mode listening (Groq Whisper large v3 turbo).
GROQ_API_KEY=

# ─── Recommended (sensible defaults exist in code) ───────────────────────────
# Main answering model. Default moonshotai/kimi-k2.6.
AI_MODEL=

# Comma-separated backups. Default z-ai/glm-5.3-flash,nvidia/nemotron-3-super-120b-a12b,openai/gpt-oss-20b.
AI_MODEL_FALLBACKS=

# How long the main model may stay silent before the next one takes over (default 6000; 9000 suits Kimi).
AI_FIRST_BYTE_MS=

# true/false — show-think models' reasoning mode. Keep false for speed.
AI_THINKING=

# Fast model Live Mode asks first. Default z-ai/glm-5.3-flash.
AI_LIVE_MODEL=

# Lets BODHA read GitHub reliably. Create a fine-grained token with read-only access to PUBLIC repositories only.
GITHUB_TOKEN=

# Whose repositories 'my GitHub' means (e.g. srijan7815-bit).
GITHUB_DEFAULT_OWNER=

# ─── Web search: Tavily → TinyFish → (keyless) ────────────────────────────────
# First engine, built for AI search (tavily.com).
TAVILY_API_KEY=

# Second engine, used when Tavily has no key or is out of credit. Free search within a
# daily allowance. Key: tinyfish.ai → API keys. Read by searchTinyFish in src/lib/web.ts.
TINYFISH_API_KEY=

# Gives BODHA's Computer a real isolated computer that can run Python and shell commands (e2b.dev).
E2B_API_KEY=

# ─── Agenta research agent (deep research) ────────────────────────────────────
# The "web research" agent created in the Agenta workspace. Used only for research
# requests and when every fast search engine fails — never on the ordinary path.
AGENTA_API_KEY=

# Where the Agenta deployment lives. Default https://cloud.agenta.ai
# AGENTA_HOST=https://cloud.agenta.ai

# The project the agent belongs to; discovered automatically when it is left empty.
# AGENTA_PROJECT_ID=

# Which agent answers — a workflow/application slug. Left empty, the most
# research-looking agent in the project is chosen automatically.
# AGENTA_AGENT_SLUG=

# Or point straight at one revision / workflow id.
# AGENTA_AGENT_ID=
# AGENTA_WORKFLOW_REVISION_ID=

# ─── OpenViking memory layer ──────────────────────────────────────────────────
# Long-term memory about the student (github.com/volcengine/OpenViking).
# Self-hosted or Railway: the server's address, e.g. http://127.0.0.1:1933
# Leave both empty to run without memory — the tutor simply keeps none.
# OPENVIKING_URL=

# With a key and no URL, Volcengine's hosted OpenViking Service is assumed.
# OPENVIKING_API_KEY=

# Optional: a fixed memory root instead of viking://user/<student-id>
# OPENVIKING_USER_ROOT=

# ─── Cloud189 cold storage (backups, run from your own machine) ───────────────
# Not used by the deployed app: cloud189 logs in with a QR scan into a CLI session
# file, so it belongs on a laptop, not on Vercel. See scripts/cloud189-backup.mjs
# and docs/INTEGRATIONS.md.
# CLOUD189_ENABLED=
# CLOUD189_FOLDER_ID=

# ─── Optional overrides ───────────────────────────────────────────────────────
# AI_API_KEY=
# AI_BASE_URL=
# NVIDIA_BASE_URL=
# NVIDIA_OCR_MODEL=
# PARAKEET_FUNCTION_ID=
# AI_CUSTOM_FIRST_BYTE_MS=
# FISH_AUDIO_TTS_MODEL=
# FISH_AUDIO_STT_MODEL=
# FISH_TTS_URL=
# FISH_STT_URL=
# FISH_CONCURRENCY=
# FISH_VOICE_ARIA=
# FISH_VOICE_SOFIA=
# FISH_VOICE_MIA=
# FISH_VOICE_RAY=
# FISH_VOICE_JASON=
# FISH_VOICE_LEO=
# FISH_VOICE_HINDI_F=
# FISH_VOICE_HINDI_M=
# GROQ_STT_MODEL=
# GROQ_STT_URL=
# STT_LANGUAGE=
# STT_PROMPT=
# WATCHDOG_MODEL=
# WATCHDOG_AI=
# FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# BODHA_ALLOW_LOOPBACK_ENDPOINTS=
